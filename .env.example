# The Sacks Protocol - Environment Configuration

# Google Gemini API key for LLM relevance scoring
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# Optional: Override default model for relevance scoring
# Default is gemini-2.0-flash
# RELEVANCE_MODEL=gemini-2.0-flash

# Optional: Sefaria API settings
# No API key required - Sefaria is open
# SEFARIA_BASE_URL=https://www.sefaria.org/api

# Optional: Output settings
# OUTPUT_DIR=./output
